import Birch.GridCounting
import Mathlib.RingTheory.MvPolynomial.EulerIdentity
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem

/-!
# Coordinate rings for the Hessian incidence

The incidence equations in Browning–Heath-Brown, Lemma 1, specialize to the
gradient equations of the directional derivative. The diagonal section has
the original gradient coordinate ring when the degree minus one is invertible.
-/

open MvPolynomial
open scoped BigOperators

namespace Birch

noncomputable section

variable {K : Type*} [CommRing K] {n : ℕ}

/-- Formal mixed partial derivatives commute over any coefficient ring. -/
theorem hessian_pderiv_swap (G : MvPolynomial (Fin n) K) (i j : Fin n) :
    pderiv i (pderiv j G) = pderiv j (pderiv i G) := by
  by_cases hij : i = j
  · subst j
    rfl
  ext m
  simp only [coeff_pderiv, Finsupp.add_apply,
    Finsupp.single_eq_of_ne hij, Finsupp.single_eq_of_ne (Ne.symm hij), add_zero]
  rw [add_right_comm]
  ring

/-- A polynomial equation for the Hessian incidence, with the point and
direction represented by the first and second blocks of variables. -/
def hessianIncidenceEquation (G : MvPolynomial (Fin n) K) (i : Fin n) :
    MvPolynomial (Fin n ⊕ Fin n) K :=
  ∑ j, X (Sum.inr j) * rename Sum.inl (pderiv j (pderiv i G))

/-- At a fixed direction, the incidence equation becomes the corresponding
partial derivative of the directional derivative. -/
theorem hessianIncidenceEquation_specialize (G : MvPolynomial (Fin n) K)
    (i : Fin n) (u : Fin n → K) :
    aeval (Sum.elim X (fun j => C (u j))) (hessianIncidenceEquation G i) =
      pderiv i (directionalDerivativeOver u G) := by
  have hcomp : (Sum.elim X (fun j => C (u j))) ∘ Sum.inl =
      (X : Fin n → MvPolynomial (Fin n) K) := rfl
  simp only [hessianIncidenceEquation, directionalDerivativeOver, map_sum, map_mul, aeval_X,
    Sum.elim_inr, aeval_rename, hcomp, aeval_X_left_apply, pderiv_C_mul]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [hessian_pderiv_swap G j i]

/-- The diagonal specialization is Euler's identity applied to a gradient
component. -/
theorem hessianIncidenceEquation_diagonal {G : MvPolynomial (Fin n) K} {e : ℕ}
    (hG : G.IsHomogeneous e) (i : Fin n) :
    rename (Sum.elim id id) (hessianIncidenceEquation G i) = (e-1) • pderiv i G := by
  have hcomp : (Sum.elim id id) ∘ Sum.inl = (id : Fin n → Fin n) := rfl
  simp only [hessianIncidenceEquation, map_sum, map_mul, rename_X, Sum.elim_inr, id_eq,
    rename_rename, hcomp, rename_id, AlgHom.id_apply]
  exact (hG.pderiv (i := i)).sum_X_mul_pderiv

/-- When the degree minus one is invertible, the equations restricted to the
diagonal generate exactly the gradient ideal. -/
theorem hessianIncidence_diagonal_gradient_ideal {K : Type*} [Field K]
    {G : MvPolynomial (Fin n) K} {e : ℕ} (hG : G.IsHomogeneous e)
    (he : ((e-1 : ℕ) : K) ≠ 0) :
    Ideal.span (Set.range (fun i => rename (Sum.elim id id) (hessianIncidenceEquation G i))) =
      Ideal.span (Set.range (fun i => pderiv i G)) := by
  simp_rw [hessianIncidenceEquation_diagonal hG]
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change (e-1) • pderiv i G ∈ Ideal.span _
    rw [nsmul_eq_mul]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    have hz : ((e-1) • pderiv i G) ∈
        Ideal.span (Set.range (fun j => (e-1) • pderiv j G)) := Ideal.subset_span ⟨i, rfl⟩
    have hm := Ideal.mul_mem_left _ (C (((e-1 : ℕ) : K)⁻¹)) hz
    rwa [nsmul_eq_mul, ← map_natCast C, ← mul_assoc, ← map_mul, inv_mul_cancel₀ he, map_one,
      one_mul] at hm

/-- The linear equations equating point and direction coordinates. -/
def hessianDiagonalIdeal (K : Type*) [CommRing K] (n : ℕ) :
    Ideal (MvPolynomial (Fin n ⊕ Fin n) K) :=
  Ideal.span (Set.range fun i => X (Sum.inl i) - X (Sum.inr i))

private theorem rename_diagonal_surjective : Function.Surjective
    (rename (R := K) (Sum.elim id id : Fin n ⊕ Fin n → Fin n)) := by
  intro g
  refine ⟨rename Sum.inl g, ?_⟩
  rw [rename_rename, show (Sum.elim id id) ∘ Sum.inl = (id : Fin n → Fin n) from rfl,
    rename_id]
  rfl

/-- The kernel of substitution onto the diagonal is generated by the linear
equations defining the diagonal. -/
theorem ker_rename_hessianDiagonal :
    RingHom.ker (rename (R := K) (Sum.elim id id : Fin n ⊕ Fin n → Fin n)).toRingHom =
      hessianDiagonalIdeal K n := by
  let R := MvPolynomial (Fin n ⊕ Fin n) K
  let J := hessianDiagonalIdeal K n
  let φ : R →ₐ[K] MvPolynomial (Fin n) K := rename (Sum.elim id id)
  let ψ : MvPolynomial (Fin n) K →ₐ[K] R := rename Sum.inl
  let q : R →ₐ[K] R ⧸ J := Ideal.Quotient.mkₐ K J
  have hφL (i : Fin n) : φ (X (Sum.inl i)) = X i := rename_X _ _
  have hφR (i : Fin n) : φ (X (Sum.inr i)) = X i := rename_X _ _
  have hψ (i : Fin n) : ψ (X i) = X (Sum.inl i) := rename_X _ _
  have hcomp : q.comp (ψ.comp φ) = q := by
    apply MvPolynomial.algHom_ext
    intro i
    cases i with
    | inl i =>
      change q (ψ (φ (X (Sum.inl i)))) = q (X (Sum.inl i))
      rw [hφL, hψ]
    | inr i =>
      change q (ψ (φ (X (Sum.inr i)))) = q (X (Sum.inr i))
      rw [hφR, hψ]
      apply sub_eq_zero.mp
      rw [← map_sub]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
  change RingHom.ker φ.toRingHom = J
  apply le_antisymm
  · intro g hg
    have hg' : φ g = 0 := RingHom.mem_ker.mp hg
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change q g = 0
    rw [← hcomp]
    change q (ψ (φ g)) = 0
    simp [hg']
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    apply RingHom.mem_ker.mpr
    change φ (X (Sum.inl i) - X (Sum.inr i)) = 0
    rw [map_sub, hφL, hφR, sub_self]

/-- The ideal generated by the equations defining the Hessian incidence. -/
def hessianIncidenceIdeal (G : MvPolynomial (Fin n) K) :
    Ideal (MvPolynomial (Fin n ⊕ Fin n) K) :=
  Ideal.span (Set.range (hessianIncidenceEquation G))

/-- The incidence coordinate ring after adjoining the diagonal equations is
isomorphic to the gradient coordinate ring of the original form. -/
def hessianIncidenceDiagonalEquiv {K : Type*} [Field K]
    {G : MvPolynomial (Fin n) K} {e : ℕ} (hG : G.IsHomogeneous e)
    (he : ((e-1 : ℕ) : K) ≠ 0) :
    (MvPolynomial (Fin n ⊕ Fin n) K ⧸
      (hessianIncidenceIdeal G ⊔ hessianDiagonalIdeal K n)) ≃+*
    (MvPolynomial (Fin n) K ⧸ Ideal.span (Set.range fun i => pderiv i G)) := by
  let R := MvPolynomial (Fin n ⊕ Fin n) K
  let R₀ := MvPolynomial (Fin n) K
  let I := hessianIncidenceIdeal G
  let J := hessianDiagonalIdeal K n
  let L : Ideal R₀ := Ideal.span (Set.range fun i => pderiv i G)
  let φ : R →+* R₀ := (rename (Sum.elim id id)).toRingHom
  have hφ : Function.Surjective φ := rename_diagonal_surjective
  have hker : RingHom.ker φ = J := ker_rename_hessianDiagonal
  have himage : Ideal.map φ I = L := by
    change Ideal.map φ (Ideal.span (Set.range (hessianIncidenceEquation G))) = _
    rw [Ideal.map_span, ← Set.range_comp]
    exact hessianIncidence_diagonal_gradient_ideal hG he
  let φ₀ : R →+* R₀ ⧸ L := (Ideal.Quotient.mk L).comp φ
  have hφ₀ : Function.Surjective φ₀ := Ideal.Quotient.mk_surjective.comp hφ
  have hφker : RingHom.ker φ₀ = I ⊔ J := by
    change Ideal.comap φ (RingHom.ker (Ideal.Quotient.mk L)) = I ⊔ J
    rw [Ideal.mk_ker, ← himage, Ideal.comap_map_of_surjective φ hφ, ← RingHom.ker_eq_comap_bot,
      hker]
  exact (Ideal.quotEquivOfEq hφker.symm).trans (RingHom.quotientKerEquivOfSurjective hφ₀)

/-- Every prime of the incidence ring lying on the diagonal has height at most
the gradient dimension plus the number of diagonal equations. -/
theorem hessianIncidence_height_le_on_diagonal {K : Type*} [Field K]
    {G : MvPolynomial (Fin n) K} {e : ℕ} (hG : G.IsHomogeneous e)
    (he : ((e-1 : ℕ) : K) ≠ 0)
    (q : Ideal (MvPolynomial (Fin n ⊕ Fin n) K ⧸ hessianIncidenceIdeal G)) [q.IsPrime]
    (hq : ∀ i : Fin n, Ideal.Quotient.mk (hessianIncidenceIdeal G)
      (X (Sum.inl i) - X (Sum.inr i)) ∈ q) :
    q.height ≤ ringKrullDim
      (MvPolynomial (Fin n) K ⧸ Ideal.span (Set.range fun i => pderiv i G)) + n := by
  let R := MvPolynomial (Fin n ⊕ Fin n) K
  let I := hessianIncidenceIdeal G
  let J := hessianDiagonalIdeal K n
  let f : Fin n → R ⧸ I := fun i => Ideal.Quotient.mk I (X (Sum.inl i) - X (Sum.inr i))
  let S := Set.range f
  have hJ : Ideal.span S = Ideal.map (Ideal.Quotient.mk I) J := by
    change Ideal.span (Set.range f) = Ideal.map (Ideal.Quotient.mk I) (Ideal.span _)
    rw [Ideal.map_span, ← Set.range_comp]
    rfl
  have hcard : S.encard ≤ (n : ℕ∞) := by
    change (Set.range f).encard ≤ _
    rw [← Set.image_univ]
    simpa using Set.encard_image_le f Set.univ
  have hdim := Ideal.height_le_ringKrullDim_quotient_add_encard (p := q) S
    (by rintro _ ⟨i, rfl⟩; exact hq i)
  rw [hJ, ringKrullDim_eq_of_ringEquiv
    ((DoubleQuot.quotQuotEquivQuotSup I J).trans (hessianIncidenceDiagonalEquiv hG he))] at hdim
  exact hdim.trans (add_le_add_right (WithBot.coe_le_coe.mpr hcard) _)

end

end Birch
