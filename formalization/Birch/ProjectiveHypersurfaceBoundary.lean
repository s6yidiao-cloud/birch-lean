module

public import Birch.ProjectiveHypersurfaceRenaming
public import Birch.OpenClosedFieldPoints
public import Birch.DeligneSchemeChart
public import Birch.DeligneLevelClosure
public import Mathlib.Algebra.Polynomial.Div

@[expose] public section

/-! # The closed boundary of the standard hypersurface chart -/

open AlgebraicGeometry CategoryTheory MvPolynomial
open Graded HomogeneousIdeal

namespace Birch

noncomputable section

universe u

variable {σ K : Type u} [Field K]

attribute [local instance] MvPolynomial.gradedAlgebra

/-- Set the distinguished homogeneous coordinate to zero. -/
def setExtraCoordinateZero : MvPolynomial (Option σ) K →ₐ[K] MvPolynomial σ K :=
  killCompl (Option.some_injective σ)

@[simp] theorem setExtraCoordinateZero_X_none :
    setExtraCoordinateZero (X (R := K) (none : Option σ)) = 0 := by
  simp [setExtraCoordinateZero, killCompl]

@[simp] theorem setExtraCoordinateZero_rename_some (g : MvPolynomial σ K) :
    setExtraCoordinateZero (rename some g) = g :=
  killCompl_rename_app _ g

/-- The coefficient ring is unchanged by the boundary specialization. -/
@[simp] theorem setExtraCoordinateZero_C (a : K) :
    setExtraCoordinateZero (C a : MvPolynomial (Option σ) K) = C a :=
  killCompl_C _ a

@[simp] theorem setExtraCoordinateZero_X_some (i : σ) :
    setExtraCoordinateZero (X (R := K) (some i)) = X i := by
  rw [← rename_X, setExtraCoordinateZero_rename_some]

/-- The boundary specialization preserves homogeneous degree. -/
theorem isHomogeneous_setExtraCoordinateZero {d : ℕ}
    {F : MvPolynomial (Option σ) K} (hF : F.IsHomogeneous d) :
    (setExtraCoordinateZero F).IsHomogeneous d := by
  intro m hm
  have hm' : m.mapDomain some ∈ F.support := by
    rw [mem_support_iff, ← coeff_killCompl (Option.some_injective σ)]
    exact hm
  have hdeg := (hF.degree_eq_sum_deg_support hm').symm
  change (m.mapDomain some).degree = d at hdeg
  change (Finsupp.weight fun _ : σ => (1 : ℕ)) m = d
  rw [← Finsupp.degree_eq_weight_one]
  simpa only [Finsupp.degree_mapDomain] using hdeg

/-- The boundary equation of a homogenized affine level is its leading form. -/
theorem setExtraCoordinateZero_deligneLevelClosure {r : ℕ} (hr : 0 < r)
    (g : MvPolynomial σ K) (t : K) :
    setExtraCoordinateZero (deligneLevelClosure r g t) = homogeneousComponent r g := by
  rw [deligneLevelClosure, degreeHomogenization, map_sum, Finset.sum_eq_single r]
  · simp [map_sub, homogeneousComponent_eq_zero r (C t) (by
      simpa only [totalDegree_C] using hr)]
  · intro j hj hne
    have hpos : 0 < r - j := by have := Finset.mem_range.mp hj; omega
    simp [zero_pow hpos.ne']
  · simp

/-- The kernel of setting the distinguished coordinate to zero is the
principal ideal generated by that coordinate. -/
theorem ker_setExtraCoordinateZero :
    RingHom.ker (setExtraCoordinateZero (σ := σ) (K := K)).toRingHom =
      Ideal.span {X none} := by
  let e := optionEquivLeft K σ
  have he : setExtraCoordinateZero.toRingHom = (Polynomial.evalRingHom 0).comp e.toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp [e]
    · intro i
      cases i with
      | none => simp [e]
      | some i => simp [e]
  apply le_antisymm
  · intro g hg
    have hev := RingHom.mem_ker.mp hg
    rw [he, RingHom.comp_apply] at hev
    change (e g).eval 0 = 0 at hev
    rw [← Polynomial.coeff_zero_eq_eval_zero] at hev
    obtain ⟨b, hb⟩ := Polynomial.X_dvd_iff.mpr hev
    apply Ideal.mem_span_singleton.mpr
    refine ⟨e.symm b, e.injective ?_⟩
    rw [map_mul, e.apply_symm_apply]
    simpa [e] using hb
  · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
    exact setExtraCoordinateZero_X_none

section Boundary

variable {d : ℕ} {F : MvPolynomial (Option σ) K} (hF : F.IsHomogeneous d)

/-- The graded quotient homomorphism defining the boundary. -/
def projectiveHypersurfaceBoundaryHom :
    hypersurfaceGrading F hF →+*ᵍ
      hypersurfaceGrading (setExtraCoordinateZero F) (isHomogeneous_setExtraCoordinateZero hF) where
  __ := Ideal.Quotient.lift (Ideal.span {F})
    ((Ideal.Quotient.mk (Ideal.span {setExtraCoordinateZero F})).comp
      setExtraCoordinateZero.toRingHom) (by
        have h : Ideal.span {F} ≤ RingHom.ker
            ((Ideal.Quotient.mk (Ideal.span {setExtraCoordinateZero F})).comp
              setExtraCoordinateZero.toRingHom) := by
          rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, RingHom.comp_apply]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
        exact fun _ hp => h hp)
  map_mem := by
    rintro j x ⟨a, ha, rfl⟩
    exact ⟨setExtraCoordinateZero a, isHomogeneous_setExtraCoordinateZero ha, rfl⟩

@[simp] theorem projectiveHypersurfaceBoundaryHom_apply_mk (g : MvPolynomial (Option σ) K) :
    projectiveHypersurfaceBoundaryHom hF (Ideal.Quotient.mk (Ideal.span {F}) g) =
      Ideal.Quotient.mk (Ideal.span {setExtraCoordinateZero F}) (setExtraCoordinateZero g) := rfl

theorem projectiveHypersurfaceBoundaryHom_surjective :
    Function.Surjective (projectiveHypersurfaceBoundaryHom hF) := by
  intro q
  obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective q
  refine ⟨Ideal.Quotient.mk (Ideal.span {F}) (rename some g), ?_⟩
  rw [projectiveHypersurfaceBoundaryHom_apply_mk, setExtraCoordinateZero_rename_some]

/-- In the homogeneous coordinate ring of the hypersurface, the ideal of
the boundary is generated by the class of the distinguished coordinate. -/
theorem ker_projectiveHypersurfaceBoundaryHom :
    RingHom.ker (projectiveHypersurfaceBoundaryHom hF).toRingHom =
      Ideal.span {hypersurfaceQuotientHom hF (X none)} := by
  let π := Ideal.Quotient.mk (Ideal.span {F})
  let ρ := projectiveHypersurfaceBoundaryHom hF
  change RingHom.ker ρ.toRingHom = Ideal.span {π (X none)}
  apply le_antisymm
  · intro q hq
    obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective q
    have hg : ρ (π g) = 0 := hq
    rw [projectiveHypersurfaceBoundaryHom_apply_mk, Ideal.Quotient.eq_zero_iff_mem,
      Ideal.mem_span_singleton] at hg
    obtain ⟨b, hb⟩ := hg
    have hv : g - F * rename some b ∈ RingHom.ker
        (setExtraCoordinateZero (σ := σ) (K := K)).toRingHom := by
      change setExtraCoordinateZero (g - F * rename some b) = 0
      rw [map_sub, map_mul, setExtraCoordinateZero_rename_some, hb, sub_self]
    rw [ker_setExtraCoordinateZero, Ideal.mem_span_singleton] at hv
    obtain ⟨z, hz⟩ := hv
    apply Ideal.mem_span_singleton.mpr
    refine ⟨π z, ?_⟩
    have hF₀ : π F = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self F)
    have he := congrArg π hz
    simpa only [map_sub, map_mul, hF₀, zero_mul, sub_zero] using he
  · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
    change ρ (π (X none)) = 0
    rw [projectiveHypersurfaceBoundaryHom_apply_mk, setExtraCoordinateZero_X_none, map_zero]

/-- The closed boundary defined by setting the distinguished coordinate to zero. -/
def projectiveHypersurfaceBoundaryι :
    projectiveHypersurface (isHomogeneous_setExtraCoordinateZero hF) ⟶ projectiveHypersurface hF :=
  Proj.map (projectiveHypersurfaceBoundaryHom hF) (proj_irrelevant_le_map_of_surjective _
    (projectiveHypersurfaceBoundaryHom_surjective hF))

instance : IsClosedImmersion (projectiveHypersurfaceBoundaryι hF) :=
  isClosedImmersion_proj_map_of_surjective _ (projectiveHypersurfaceBoundaryHom_surjective hF)

end Boundary

section ProjRange

variable {A B α β : Type u} [CommRing A] [SetLike α A] [AddSubgroupClass α A]
  [CommRing B] [SetLike β B] [AddSubgroupClass β B]
  {𝒜 : ℕ → α} {ℬ : ℕ → β} [GradedRing 𝒜] [GradedRing ℬ]

/-- The range of the morphism of projective spectra induced by a graded
surjection is the zero locus of its kernel. -/
theorem range_proj_map_eq_zeroLocus_ker_of_surjective (f : 𝒜 →+*ᵍ ℬ)
    (hf : Function.Surjective f) (h : ℬ₊ ≤ 𝒜₊.map f) :
    Set.range (Proj.map f h) = ProjectiveSpectrum.zeroLocus 𝒜 (RingHom.ker f.toRingHom) := by
  have hmap : 𝒜₊.map f ≤ ℬ₊ := by
    apply HomogeneousIdeal.map_le_of_le_comap
    rw [HomogeneousIdeal.irrelevant_le]
    intro i hi a ha
    exact mem_irrelevant_of_mem _ hi (map_mem f ha)
  change Set.range (ProjectiveSpectrum.comapFun f h) =
    ProjectiveSpectrum.zeroLocus 𝒜 (RingHom.ker f.toRingHom)
  ext x
  constructor
  · rintro ⟨y, rfl⟩ a ha
    change f a ∈ y.asHomogeneousIdeal
    rw [show f a = 0 from RingHom.mem_ker.mp ha]
    exact zero_mem _
  · intro hx
    let I := x.asHomogeneousIdeal
    let J := I.map f
    have hk : RingHom.ker f.toRingHom ≤ I.toIdeal := hx
    have hcom : J.comap f = I := by
      apply HomogeneousIdeal.ext
      change (I.toIdeal.map f.toRingHom).comap f.toRingHom = I.toIdeal
      rw [Ideal.comap_map_of_surjective f.toRingHom hf, ← RingHom.ker_eq_comap_bot,
        sup_eq_left.mpr hk]
    have hp : J.toIdeal.IsPrime :=
      Ideal.map_isPrime_of_surjective (f := f.toRingHom) hf hk
    let y : ProjectiveSpectrum ℬ := ⟨J, hp, fun hj => by
      have hj' := (HomogeneousIdeal.map_le_iff_le_comap f).mp (hmap.trans hj)
      rw [hcom] at hj'
      exact x.not_irrelevant_le hj'⟩
    exact ⟨y, ProjectiveSpectrum.ext hcom⟩

end ProjRange

/-- The image of the closed boundary is precisely the complement of the
standard affine chart. -/
theorem range_projectiveHypersurfaceBoundaryι {d : ℕ} {F : MvPolynomial (Option σ) K}
    (hF : F.IsHomogeneous d) :
    Set.range (projectiveHypersurfaceBoundaryι hF) =
      (Set.range (standardHypersurfaceChartι hF))ᶜ := by
  change Set.range (Proj.map (projectiveHypersurfaceBoundaryHom hF) _) = _
  rw [range_proj_map_eq_zeroLocus_ker_of_surjective _ (projectiveHypersurfaceBoundaryHom_surjective hF),
    ker_projectiveHypersurfaceBoundaryHom, ProjectiveSpectrum.zeroLocus_span,
    ← Scheme.Hom.coe_opensRange, opensRange_standardHypersurfaceChartι]
  change _ = (ProjectiveSpectrum.basicOpen (hypersurfaceGrading F hF)
    (hypersurfaceQuotientHom hF (X none)) : Set (ProjectiveSpectrum (hypersurfaceGrading F hF)))ᶜ
  rw [ProjectiveSpectrum.basicOpen_eq_zeroLocus_compl, compl_compl]

section Counts

variable {d : ℕ} {F : MvPolynomial (Option σ) K} (hF : F.IsHomogeneous d)

/-- The boundary closed immersion preserves the structure maps to the field. -/
@[reassoc] theorem projectiveHypersurfaceBoundaryι_toField :
    projectiveHypersurfaceBoundaryι hF ≫ projectiveHypersurfaceToField hF =
      projectiveHypersurfaceToField (isHomogeneous_setExtraCoordinateZero hF) := by
  unfold projectiveHypersurfaceBoundaryι projectiveHypersurfaceToField
  rw [← Category.assoc, proj_map_toSpecZero, Category.assoc, ← Spec.map_comp]
  congr 1
  apply congrArg Spec.map
  apply CommRingCat.hom_ext
  ext a
  change projectiveHypersurfaceBoundaryHom hF (Ideal.Quotient.mk _ (C a)) =
    Ideal.Quotient.mk _ (C a)
  rw [projectiveHypersurfaceBoundaryHom_apply_mk, setExtraCoordinateZero_C]

/-- Field-valued points of the projective level split into affine level
points and the points at infinity. -/
def deligneLevelSchemePointsEquivSum {L : Type u} [Field L] [Algebra K L]
    {r : ℕ} {g : MvPolynomial σ K} (hg : g.totalDegree ≤ r) (t : K) :
    let hF := isHomogeneous_deligneLevelClosure r g t
    SchemeFieldValuedPoints (projectiveHypersurfaceToField hF) L ≃
      {x : σ → L // g.eval₂ (algebraMap K L) x = algebraMap K L t} ⊕
        SchemeFieldValuedPoints
          (projectiveHypersurfaceToField (isHomogeneous_setExtraCoordinateZero hF)) L := by
  let hF := isHomogeneous_deligneLevelClosure r g t
  let f := projectiveHypersurfaceToField hF
  let i := projectiveHypersurfaceBoundaryι hF
  let j := standardHypersurfaceChartι hF
  have hij : Set.range j = (Set.range i)ᶜ := by
    change Set.range (standardHypersurfaceChartι hF) = (Set.range (projectiveHypersurfaceBoundaryι hF))ᶜ
    rw [range_projectiveHypersurfaceBoundaryι, compl_compl]
  let e := fieldValuedPointsOpenClosedEquiv (L := L) f i j hij
  exact e.symm.trans (Equiv.sumCongr
    ((fieldValuedPointsInOpenEquiv (L := L) f j).trans (deligneLevelSchemeAffinePointsEquiv hg t))
    (Equiv.subtypeEquivRight fun x => by
      change (x ≫ (i ≫ f) = _) ↔ (x ≫ projectiveHypersurfaceToField (isHomogeneous_setExtraCoordinateZero hF) = _)
      rw [show i ≫ f = _ from projectiveHypersurfaceBoundaryι_toField hF]))

/-- The affine level count equals the full projective level count minus
the count of its closed boundary. -/
theorem natCard_deligneLevel_eq_projective_sub_boundary {L : Type u} [Field L]
    [Algebra K L] {r : ℕ} {g : MvPolynomial σ K} (hg : g.totalDegree ≤ r) (t : K)
    [Finite (SchemeFieldValuedPoints
      (projectiveHypersurfaceToField (isHomogeneous_deligneLevelClosure r g t)) L)] :
    let hF := isHomogeneous_deligneLevelClosure r g t
    Nat.card {x : σ → L // g.eval₂ (algebraMap K L) x = algebraMap K L t} =
      Nat.card (SchemeFieldValuedPoints (projectiveHypersurfaceToField hF) L) -
        Nat.card (SchemeFieldValuedPoints
          (projectiveHypersurfaceToField (isHomogeneous_setExtraCoordinateZero hF)) L) := by
  let e := deligneLevelSchemePointsEquivSum (L := L) hg t
  let := Finite.of_equiv _ e
  have := Finite.of_injective _ (e.symm.injective.comp Sum.inl_injective)
  have := Finite.of_injective _ (e.symm.injective.comp Sum.inr_injective)
  dsimp only
  rw [Nat.card_congr e, Nat.card_sum, Nat.add_sub_cancel]


end Counts

end

end Birch
